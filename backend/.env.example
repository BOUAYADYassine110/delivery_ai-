# Database Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=delivery_system

# Security
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Optional - for CrewAI integration)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# External APIs (Optional - system works without these)
ORS_API_KEY=your-openrouteservice-api-key-here
OWM_API_KEY=your-openweathermap-api-key-here

# Application Settings
APP_NAME=Multi-Agent Delivery System
APP_VERSION=3.0
DEBUG=True
ENVIRONMENT=development

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
FRONTEND_URL=http://localhost:5173

# Commission & Pricing
DRIVER_COMMISSION_RATE=0.15
BASE_PRICE_INTRA_CITY=25.0
BASE_PRICE_INTER_CITY=50.0
